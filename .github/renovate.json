{
	"extends": [
		"config:recommended",
		":dependencyDashboard",
		":timezone(Etc/UTC)",
		":preserveSemverRanges"
	],
	"internalChecksFilter": "strict",
	"rebaseWhen": "conflicted",
	"packageRules": [
		{
			"description": "Add the ci and github-actions GitHub label to GitHub Action bump PRs",
			"matchManagers": [
				"github-actions"
			],
			"labels": [
				"ci",
				"github-actions"
			]
		},
		{
			"description": "Add the uv and dependency GitHub label to uv dependency bump PRs",
			"matchManagers": [
				"uv"
			],
			"labels": [
				"uv",
				"dependencies"
			]
		}
	]
}
